# Twilio SMS configuration — keep real secrets in your local .env / environment only.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# SIH26083 stakeholder recipients (E.164 format, e.g. +9198xxxxxxxx)
RAKSHA_MUNICIPAL_WARD_OFFICER_PHONE=
RAKSHA_DISASTER_MANAGEMENT_PHONE=
RAKSHA_HEALTH_COORDINATION_PHONE=

# Twilio trial compatibility. Keep true while using a Twilio trial account.
# Trial SMS must use a Twilio-provided template name instead of custom text.
RAKSHA_TWILIO_TRIAL_MODE=true
RAKSHA_TWILIO_TRIAL_TEMPLATE=sms_internal_alerts

# After upgrading Twilio, set RAKSHA_TWILIO_TRIAL_MODE=false to send the
# actual RAKSHA alert message as the SMS body.
